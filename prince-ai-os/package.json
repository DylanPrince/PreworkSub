{
  "name": "prince-ai-os",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @prince/web --filter @prince/worker dev",
    "dev:web": "pnpm --filter @prince/web dev",
    "dev:worker": "pnpm --filter @prince/worker dev",
    "build": "pnpm --filter @prince/web build",
    "start": "pnpm --filter @prince/web start",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "pnpm --filter @prince/database generate",
    "db:migrate": "pnpm --filter @prince/database migrate:dev",
    "db:deploy": "pnpm --filter @prince/database migrate:deploy",
    "db:seed": "pnpm --filter @prince/database seed",
    "services:up": "docker compose up -d postgres redis",
    "services:down": "docker compose down"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "globals": "^16.0.0",
    "jsdom": "30.1.2",
    "prettier": "3.6.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4"
  }
}
