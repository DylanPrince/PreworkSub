# Copy to .env (never commit .env). All values are validated at startup by packages/shared/src/env.ts.

# Deployment environment: development | test | staging | production.
# Production refuses the mock AI provider.
APP_ENV=development

# PostgreSQL (docker compose default)
DATABASE_URL=postgresql://prince:prince@localhost:5432/prince_ai_os

# Redis for BullMQ (docker compose default)
REDIS_URL=redis://localhost:6379

# Better Auth: generate with `openssl rand -base64 32`. Required, min 32 chars.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Default AI provider for new runs: "anthropic" (real Claude API) or "mock" (deterministic local
# output; every mock run is labelled "Mock output" and costs $0). With a key set, a paid Claude run
# can still be chosen per task while the default is "mock". See docs/api-key-setup.md.
AI_PROVIDER=anthropic
# Server-side only. Leave empty until you are ready to incur API charges; paid runs are refused
# with a clear "not configured" message while it is unset. Never prefix with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=
# Default model for agents that do not override it.
AI_DEFAULT_MODEL=claude-opus-5-5

# Global AI spend limits in USD, enforced server-side before each paid request (in-flight runs
# reserve their worst case). App safeguards, not a billing cap: also set a Console spend limit.
AI_DAILY_BUDGET_USD=5
AI_MONTHLY_BUDGET_USD=50

# The first account to sign up becomes the owner. Later sign-ups are refused unless this is true.
AUTH_ALLOW_SIGNUP=false
