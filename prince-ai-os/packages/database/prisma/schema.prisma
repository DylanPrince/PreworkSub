// Prince AI OS data model. Postgres is the system of record; Redis/BullMQ only carries job ids.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Authentication (Better Auth core schema)
// ---------------------------------------------------------------------------

model User {
  id            String       @id
  name          String
  email         String       @unique
  emailVerified Boolean      @default(false)
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  sessions      Session[]
  accounts      Account[]
  memberships   Membership[]
  tasks         Task[]
  agentsCreated Agent[]
  commands      Command[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ---------------------------------------------------------------------------
// Business workspaces
// ---------------------------------------------------------------------------

enum MembershipRole {
  owner
  admin
  member
  viewer
}

model Business {
  id            String       @id @default(cuid())
  name          String
  slug          String       @unique
  description   String       @default("")
  businessModel String       @default("")
  goals         String[]     @default([])
  archivedAt    DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  memberships   Membership[]
  agents        Agent[]
  tasks         Task[]
  runs          AgentRun[]
  commands      Command[]
}

model Membership {
  id         String         @id @default(cuid())
  businessId String
  userId     String
  role       MembershipRole @default(member)
  createdAt  DateTime       @default(now())
  business   Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Agent registry
// ---------------------------------------------------------------------------

enum AgentStatus {
  active
  disabled
  /// Hidden from task creation and the main roster; history is kept.
  archived
}

/// An agent instance. businessId = null means it is a shared agent available to every workspace
/// (it still only ever sees the data of the business a given task belongs to).
/// templateKey = null means a custom agent created in Agent Builder (always business-scoped).
model Agent {
  id                 String         @id @default(cuid())
  templateKey        String?
  /// Template a custom agent was duplicated from, for provenance only.
  basedOnTemplateKey String?
  createdById        String?
  businessId         String?
  name               String
  description        String
  specialization     String
  division           String
  status             AgentStatus    @default(active)
  currentVersion     Int            @default(1)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  business           Business?      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdBy          User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)
  versions           AgentVersion[]
  tasks              Task[]
  runs               AgentRun[]

  @@unique([templateKey, businessId])
  @@index([businessId])
}

/// Immutable configuration snapshot. Runs pin the version they executed with.
/// How much reasoning Claude puts into a response. Thinking tokens are billed as output and count
/// toward maxOutputTokens, so higher effort needs a larger output allowance.
enum ReasoningEffort {
  low
  medium
  high
}

model AgentVersion {
  id              String   @id @default(cuid())
  agentId         String
  version         Int
  model           String
  systemPrompt    String
  allowedTools    String[] @default([])
  permissions     String[] @default([])
  outputSchemaKey String
  maxOutputTokens Int      @default(4096)
  budgetUsdPerRun Decimal  @default(0.5) @db.Decimal(12, 6)
  timeoutMs       Int      @default(120000)
  maxAttempts     Int      @default(3)
  /// Sent as output_config.effort. Null leaves the model's own default in place.
  effort          ReasoningEffort?
  changeNote      String   @default("")
  createdById     String?
  createdAt       DateTime @default(now())
  agent           Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, version])
}

// ---------------------------------------------------------------------------
// Tasks and execution
// ---------------------------------------------------------------------------

enum TaskStatus {
  open
  queued
  running
  succeeded
  failed
  cancelled
}

enum TaskKind {
  standard
  /// Created from Agent Builder's test panel.
  test
}

enum RunStatus {
  queued
  running
  succeeded
  failed
  cancelled
}

model Task {
  id           String     @id @default(cuid())
  businessId   String
  agentId      String
  title        String
  instructions String
  kind         TaskKind   @default(standard)
  status       TaskStatus @default(open)
  /// Set when the task was created from an AI Command Center request.
  commandId    String?
  /// Plan workstream this task carries out (null for the planning task itself).
  workstream   String?
  createdById  String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  business     Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  agent        Agent      @relation(fields: [agentId], references: [id], onDelete: Restrict)
  createdBy    User       @relation(fields: [createdById], references: [id], onDelete: Restrict)
  command      Command?   @relation(fields: [commandId], references: [id], onDelete: SetNull)
  runs         AgentRun[]

  /// A workstream is dispatched at most once per command.
  @@unique([commandId, workstream])
  @@index([businessId, createdAt])
}

/// A request made in the AI Command Center: a planning task, then owner-approved dispatch of the
/// plan's workstreams to specialist agents.
model Command {
  id          String   @id @default(cuid())
  businessId  String
  createdById String
  request     String
  /// Idempotency key from the composer so a double submit cannot create two commands.
  clientKey   String   @unique
  planTaskId  String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdBy   User     @relation(fields: [createdById], references: [id], onDelete: Restrict)
  tasks       Task[]

  @@index([businessId, createdAt])
}

model AgentRun {
  id                       String     @id @default(cuid())
  taskId                   String
  agentId                  String
  agentVersion             Int
  businessId               String
  status                   RunStatus  @default(queued)
  idempotencyKey           String     @unique
  provider                 String
  model                    String
  attempts                 Int        @default(0)
  inputTokens              Int?
  outputTokens             Int?
  cacheCreationInputTokens Int?
  cacheReadInputTokens     Int?
  /// Part of outputTokens the model spent thinking (already included in outputTokens and cost).
  thinkingTokens           Int?
  /// USD cost of all attempts, computed from provider-reported usage and the ModelPrice table.
  costUsd                  Decimal?   @db.Decimal(12, 6)
  /// True when part of costUsd is a worst-case estimate (e.g. a request aborted before the
  /// provider reported usage) rather than provider-reported usage.
  costIsEstimate           Boolean    @default(false)
  /// Worst-case cost held against the global budget while an attempt is in flight. Counted as
  /// spend until the attempt finishes, so concurrent runs cannot jointly overshoot a limit.
  reservedUsd              Decimal?   @db.Decimal(12, 6)
  stopReason               String?
  output                   Json?
  outputText               String?
  errorCode                String?
  errorMessage             String?
  durationMs               Int?
  /// Time spent waiting on the AI provider (excludes queue wait).
  providerLatencyMs        Int?
  queuedAt                 DateTime   @default(now())
  startedAt                DateTime?
  finishedAt               DateTime?
  cancelRequestedAt        DateTime?
  task                     Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  agent                    Agent      @relation(fields: [agentId], references: [id], onDelete: Restrict)
  business                 Business   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  events                   RunEvent[]

  @@index([businessId, queuedAt])
  @@index([agentId, queuedAt])
  @@index([status])
  @@index([startedAt])
}

model RunEvent {
  id        String   @id @default(cuid())
  runId     String
  type      String
  message   String
  data      Json?
  createdAt DateTime @default(now())
  run       AgentRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, createdAt])
}

// ---------------------------------------------------------------------------
// Cost configuration and audit
// ---------------------------------------------------------------------------

/// Configurable price table (USD per million tokens). Source and verification date are recorded
/// so stale prices are visible.
model ModelPrice {
  model             String   @id
  displayName       String
  inputPerMTok      Decimal  @db.Decimal(12, 6)
  outputPerMTok     Decimal  @db.Decimal(12, 6)
  cacheWritePerMTok Decimal  @db.Decimal(12, 6)
  cacheReadPerMTok  Decimal  @db.Decimal(12, 6)
  source            String
  verifiedAt        DateTime
  updatedAt         DateTime @updatedAt
}

enum ActorType {
  user
  agent
  system
}

model AuditEvent {
  id         String    @id @default(cuid())
  actorType  ActorType
  actorId    String?
  businessId String?
  action     String
  targetType String
  targetId   String?
  summary    String
  metadata   Json?
  createdAt  DateTime  @default(now())

  @@index([businessId, createdAt])
  @@index([createdAt])
}
